---
import "../styles/experience.css";

interface Props {
  slug: "home" | "vision" | "labs";
  locale: "en" | "ta";
}

const { slug, locale } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const L = locale === "ta"
  ? {
      banner: "K2Labs — ஒரு ஆராய்ச்சி-முதல் சமூக ஆய்வகம்",
      trackA: ["ட்ராக் A", "AI வணிகக் கருவித்தொகுப்பு"],
      trackB: ["ட்ராக் பி", "AI-நேட்டிவ் மென்பொருள் பொறியியல்"],
      nodes: ["அடுக்கு-3 சமூகங்கள்", "உள்ளூர் மாணவர்கள் பயிற்சி பெற்றனர்", "தரவு வீட்டில் இருக்கும்", "ஒரு கூட்டு, ஒரு கருவி"],
      labAI: "AI சிஸ்டம்ஸ் லேப்",
      labMed: "மருத்துவ நுண்ணறிவு ஆய்வகம்",
      stamp: "முன்மாதிரி — சமூகத்துடன் வளரும்",
      q1: "கேள்விகள் எங்கிருந்து வருகின்றன?",
      q2: "ஆய்வகங்கள் எந்த நிலையில் உள்ளன?",
      q3: "அவற்றில் யார் வேலை செய்கிறார்கள்?",
      a1: "சமூகங்களே.",
      a2: "முன்மாதிரி.",
      a3: "மாணவர்கள், தன்னார்வலர்கள் மற்றும் டொமைன் நிபுணர்கள்.",
    }
  : {
      banner: "K2Labs — a research-first community lab",
      trackA: ["Track A", "AI Business Toolkit"],
      trackB: ["Track B", "AI-Native Software Engineering"],
      nodes: ["Tier-3 communities", "Local students trained", "Data stays home", "One cohort, one tool"],
      labAI: "AI Systems Lab",
      labMed: "Medical Intelligence Lab",
      stamp: "Prototype — evolving with community",
      q1: "Where do the questions come from?",
      q2: "What stage are the labs in?",
      q3: "Who works on them?",
      a1: "The communities themselves.",
      a2: "Prototype.",
      a3: "Students, volunteers and domain experts.",
    };
---

<div class="exp-page">
  <div class="exp" data-slug={slug} data-lang={locale} data-base={base}>

    <div class="stage-wrap">
      {slug === "home" && (
        <svg class="stage" viewBox="0 0 1600 900" role="img"
             aria-label={locale === "ta" ? "சிறிய நகரத்தில் கட்டப்படும் அமைப்புகள்" : "A small-town lab where students build systems"}>
          <defs>
            <linearGradient id="paperGrad" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#fff6e6"/>
              <stop offset="100%" stop-color="#e6d5b8"/>
            </linearGradient>
            <linearGradient id="sunGlow" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%" stop-color="#f59e0b" stop-opacity="0.35"/>
              <stop offset="100%" stop-color="#f59e0b" stop-opacity="0"/>
            </linearGradient>
            <linearGradient id="screenGlow" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#f59e0b" stop-opacity="0.55"/>
              <stop offset="100%" stop-color="#f59e0b" stop-opacity="0"/>
            </linearGradient>
          </defs>

          <rect width="1600" height="900" fill="url(#paperGrad)"/>
          <circle class="pulse" cx="1310" cy="180" r="200" fill="url(#sunGlow)"/>

          <!-- town (base) -->
          <g>
            <path d="M0 760 Q 150 706 330 760 L 470 760 L 470 900 L 0 900 Z" fill="#b7a382" opacity="0.5"/>
            <g fill="#a68d68" opacity="0.65">
              <rect x="70" y="706" width="60" height="52" rx="3"/>
              <path d="M70 706 L100 678 L130 706 Z"/>
              <rect x="160" y="690" width="66" height="68" rx="3"/>
              <path d="M160 690 L193 660 L226 690 Z"/>
              <rect x="258" y="712" width="52" height="46" rx="3"/>
              <path d="M258 712 L284 686 L310 712 Z"/>
              <rect x="338" y="694" width="58" height="64" rx="3"/>
              <path d="M338 694 L367 664 L396 694 Z"/>
            </g>
          </g>

          <!-- students (beat 1) -->
          <g class="part" data-show="1">
            <g class="bob" fill="#f3d9b0" stroke="#b45309" stroke-width="2">
              <circle cx="620" cy="600" r="24"/>
              <path d="M596 624 L620 688 L644 624 Z"/>
              <circle cx="500" cy="612" r="22"/>
              <path d="M478 634 L500 694 L522 634 Z"/>
              <circle cx="1010" cy="602" r="24"/>
              <path d="M986 626 L1010 690 L1034 626 Z"/>
              <circle cx="1075" cy="612" r="22"/>
              <path d="M1053 634 L1075 692 L1097 634 Z"/>
            </g>
          </g>

          <!-- desk + laptop (base) -->
          <g>
            <rect x="560" y="660" width="540" height="28" rx="8" fill="#c9b08a"/>
            <rect x="596" y="688" width="18" height="76" rx="4" fill="#b99a72"/>
            <rect x="1046" y="688" width="18" height="76" rx="4" fill="#b99a72"/>
            <ellipse cx="860" cy="668" rx="120" ry="16" fill="#f59e0b" opacity="0.15"/>
            <rect x="762" y="646" width="196" height="16" rx="5" fill="#2b2b33"/>
            <rect x="782" y="566" width="156" height="80" rx="6" fill="#0f172a"/>
            <g fill="#f59e0b" opacity="0.85">
              <rect x="798" y="584" width="110" height="5" rx="2"/>
              <rect x="798" y="597" width="86" height="5" rx="2"/>
              <rect x="798" y="610" width="120" height="5" rx="2"/>
              <rect x="798" y="623" width="70" height="5" rx="2"/>
            </g>
            <g class="part" data-show="2">
              <ellipse class="pulse" cx="860" cy="606" rx="150" ry="70" fill="url(#screenGlow)"/>
            </g>
          </g>

          <!-- banner (beat 1) -->
          <g class="part sway" data-show="1">
            <rect x="60" y="60" width="560" height="118" rx="12" fill="#fff9ee" stroke="#d8ccb2" stroke-width="2"/>
            <text x="86" y="104" font-size="30" font-weight="700" fill="#b45309">K2Labs</text>
            <text x="86" y="136" font-size="19" fill="#1c1917">{L.banner}</text>
          </g>

          <!-- track cards (beat 3) -->
          <g class="part" data-show="3">
            <g class="sway">
              <rect x="930" y="96" width="310" height="104" rx="10" fill="#f59e0b" stroke="#b45309" stroke-width="2"/>
              <text x="1085" y="128" text-anchor="middle" font-size="20" font-weight="700" fill="#0f172a">{L.trackA[0]}</text>
              <text x="1085" y="156" text-anchor="middle" font-size="16" fill="#0f172a">{L.trackA[1]}</text>
            </g>
            <g class="sway">
              <rect x="1255" y="96" width="310" height="104" rx="10" fill="#14b8a6" stroke="#0f766e" stroke-width="2"/>
              <text x="1410" y="128" text-anchor="middle" font-size="20" font-weight="700" fill="#0f172a">{L.trackB[0]}</text>
              <text x="1410" y="156" text-anchor="middle" font-size="16" fill="#0f172a">{L.trackB[1]}</text>
            </g>
          </g>

          <!-- path to the town (beat 4) -->
          <g class="part" data-show="4">
            <path d="M330 748 Q 520 700 700 672" fill="none" stroke="#f59e0b" stroke-width="7" stroke-linecap="round" stroke-dasharray="10 14"/>
            <g fill="#f59e0b">
              <circle cx="380" cy="740" r="5"/>
              <circle cx="470" cy="716" r="5"/>
              <circle cx="560" cy="694" r="5"/>
              <circle cx="650" cy="676" r="5"/>
            </g>
          </g>
        </svg>
      )}

      {slug === "vision" && (
        <svg class="stage" viewBox="0 0 1600 900" role="img"
             aria-label={locale === "ta" ? "பார்வைப் பாதை: அடுக்கு-3 சமூகங்கள்" : "Vision path: Tier-3 communities building their own tools"}>
          <defs>
            <linearGradient id="visionGrad" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#fff6e6"/>
              <stop offset="100%" stop-color="#e6d5b8"/>
            </linearGradient>
          </defs>

          <rect width="1600" height="900" fill="url(#visionGrad)"/>
          <rect x="0" y="520" width="1600" height="120" fill="#d8c4a5" opacity="0.55"/>
          <path d="M120 640 Q 800 560 1480 640" fill="none" stroke="#b45309" stroke-width="3" opacity="0.35"/>

          <!-- nodes -->
          <g class="part node" data-show="1" data-seek="1" data-active="1" role="button" tabindex="0">
            <circle cx="280" cy="470" r="58" fill="#fef3c7" stroke="#f59e0b" stroke-width="2"/>
            <text x="280" y="476" text-anchor="middle" font-size="20" font-weight="700" fill="#b45309">1</text>
            <text x="280" y="560" text-anchor="middle" font-size="19" fill="#1c1917">{L.nodes[0]}</text>
          </g>
          <g class="part node" data-show="2" data-seek="2" data-active="2" role="button" tabindex="0">
            <circle cx="620" cy="470" r="58" fill="#ccfbf1" stroke="#14b8a6" stroke-width="2"/>
            <text x="620" y="476" text-anchor="middle" font-size="20" font-weight="700" fill="#0f766e">2</text>
            <text x="620" y="560" text-anchor="middle" font-size="19" fill="#1c1917">{L.nodes[1]}</text>
          </g>
          <g class="part node" data-show="3" data-seek="3" data-active="3" role="button" tabindex="0">
            <circle cx="960" cy="470" r="58" fill="#ede9fe" stroke="#6366f1" stroke-width="2"/>
            <text x="960" y="476" text-anchor="middle" font-size="20" font-weight="700" fill="#4f46e5">3</text>
            <text x="960" y="560" text-anchor="middle" font-size="19" fill="#1c1917">{L.nodes[2]}</text>
          </g>
          <g class="part node" data-show="4" data-seek="4" data-active="4" role="button" tabindex="0">
            <circle cx="1300" cy="470" r="58" fill="#fde68a" stroke="#f59e0b" stroke-width="2"/>
            <text x="1300" y="476" text-anchor="middle" font-size="20" font-weight="700" fill="#b45309">4</text>
            <text x="1300" y="560" text-anchor="middle" font-size="19" fill="#1c1917">{L.nodes[3]}</text>
          </g>

          <text x="800" y="760" text-anchor="middle" font-size="22" fill="#6b6157" font-style="italic">
            {locale === "ta" ? "ஒரு கூட்டு, ஒரு கருவி — படிப்படியாக" : "One cohort, one tool — step by step"}
          </text>
        </svg>
      )}

      {slug === "labs" && (
        <svg class="stage" viewBox="0 0 1600 900" role="img"
             aria-label={locale === "ta" ? "இரண்டு ஆய்வகங்கள், ஒரு கேள்வி" : "Two labs, one question"}>
          <defs>
            <linearGradient id="labGrad" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#fff6e6"/>
              <stop offset="100%" stop-color="#e6d5b8"/>
            </linearGradient>
          </defs>

          <rect width="1600" height="900" fill="url(#labGrad)"/>

          <g class="part card" data-show="1" data-active="2" data-seek="2">
            <rect x="110" y="150" width="540" height="420" rx="14" fill="#fff9ee" stroke="#d8ccb2" stroke-width="2"/>
            <rect x="110" y="150" width="540" height="60" rx="14" fill="#f59e0b"/>
            <text x="150" y="186" font-size="24" font-weight="700" fill="#0f172a">{L.labAI}</text>
            <g fill="#b45309" opacity="0.75">
              <rect x="150" y="240" width="430" height="8" rx="4"/>
              <rect x="150" y="262" width="330" height="8" rx="4"/>
              <rect x="150" y="284" width="390" height="8" rx="4"/>
            </g>
            <text x="150" y="330" font-size="18" fill="#6b6157" font-style="italic">
              {locale === "ta" ? "எளிய, விளக்கக்கூடிய அமைப்புகள்" : "Simple, interpretable systems"}
            </text>
            <circle cx="560" cy="470" r="40" fill="#fde68a" opacity="0.8"/>
          </g>

          <g class="part card" data-show="1" data-active="3" data-seek="3">
            <rect x="950" y="150" width="540" height="420" rx="14" fill="#fff9ee" stroke="#d8ccb2" stroke-width="2"/>
            <rect x="950" y="150" width="540" height="60" rx="14" fill="#14b8a6"/>
            <text x="990" y="186" font-size="24" font-weight="700" fill="#0f172a">{L.labMed}</text>
            <g fill="#0f766e" opacity="0.75">
              <rect x="990" y="240" width="430" height="8" rx="4"/>
              <rect x="990" y="262" width="360" height="8" rx="4"/>
              <rect x="990" y="284" width="410" height="8" rx="4"/>
            </g>
            <text x="990" y="330" font-size="18" fill="#6b6157" font-style="italic">
              {locale === "ta" ? "சமூகத் தரவுகளுடன் சுகாதாரம்" : "Health questions with community data"}
            </text>
            <circle cx="1400" cy="470" r="40" fill="#ccfbf1" opacity="0.8"/>
          </g>

          <g class="part" data-show="4">
            <rect x="360" y="650" width="880" height="80" rx="12" fill="#fde68a" stroke="#f59e0b" stroke-width="2"/>
            <text x="800" y="692" text-anchor="middle" font-size="22" font-weight="700" fill="#0f172a">{L.stamp}</text>
          </g>
        </svg>
      )}
    </div>

    <div class="player">
      <button class="exp-play" aria-pressed="false">▶ Play</button>
      <button class="exp-prev">◀ Prev</button>
      <button class="exp-next">Next ▶</button>
      <input class="exp-scrub" type="range" min="0" max="100" value="0" aria-label="Timeline"/>
      <span class="exp-time">0:00 / 0:00</span>
      <button class="exp-captions" aria-pressed="true">Captions</button>
    </div>

    <div class="caption-bar" aria-live="polite"></div>

    {slug === "labs" && (
      <div class="checks">
        <button class="check" data-reveal="#ans1" aria-expanded="false">{L.q1}</button>
        <button class="check" data-reveal="#ans2" aria-expanded="false">{L.q2}</button>
        <button class="check" data-reveal="#ans3" aria-expanded="false">{L.q3}</button>
      </div>
      <div id="ans1" class="answer">{L.a1}</div>
      <div id="ans2" class="answer">{L.a2}</div>
      <div id="ans3" class="answer">{L.a3}</div>
    )}
  </div>
</div>


<script is:inline src={`${base}/exp/engine.js`} defer></script>
