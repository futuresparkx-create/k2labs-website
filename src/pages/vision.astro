---
import BaseLayout from "../layouts/BaseLayout.astro";
import Experience from "../components/Experience.astro";
import { marked } from "marked";

const md = (await import("../content/vision.md?raw")).default;
const html = marked.parse(md);
---

<BaseLayout
  title="Vision — K2Labs"
  description="Our vision is to enable communities to solve critical problems by transforming knowledge into ethical, accessible action."
>
  <section class="max-w-6xl mx-auto px-6 pt-16">
    <h1 class="text-3xl md:text-4xl font-semibold leading-tight">Our Vision</h1>
  </section>

  <!-- Explorable vision path: one step per beat, click a node to hear it -->
  <section class="mt-8">
    <Experience slug="vision" locale="en" />
  </section>

  <!-- Readable vision text -->
  <section class="max-w-6xl mx-auto px-6 mt-20 mb-24">
    <div class="content-panel">
      <h2 class="text-2xl font-semibold mb-6">In writing</h2>
      <article class="prose prose-invert lg:prose-lg" set:html={html}></article>
    </div>
  </section>
</BaseLayout>
