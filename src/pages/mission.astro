---
import BaseLayout from "../layouts/BaseLayout.astro";
import { marked } from "marked";

const md = (await import("../content/mission.md?raw")).default;
const html = marked.parse(md);
---

<BaseLayout
  title="Mission — K2Labs"
  description="Our mission is to build community-driven research labs that transform knowledge into real-world solutions."
>
  <section class="pt-24">
    <div class="content-panel">
      <h1 class="text-4xl font-semibold mb-6">Our Mission</h1>
      <article class="prose prose-invert lg:prose-lg" set:html={html}></article>
    </div>
  </section>
</BaseLayout>
