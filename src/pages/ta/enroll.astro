---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { GOOGLE_FORM_URL, GOOGLE_FORM_EMBED_SRC, GOOGLE_FORM_READY } from "../../config";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const enrollTitle = "ஒரு பாடத்திட்டத்தில் பதிவு செய்யுங்கள் - K2Labs";
const enrollDesc = "தென்காசி, கடையத்தில் உள்ள K2Labs AI பயிற்சி மையத்தில் சேரவும். தொடக்கநிலையாளர்களுக்கான ட்ராக் A (AI வணிகக் கருவித்தொகுப்பு) மற்றும் CS/IT பட்டதாரிகளுக்கு ட்ராக் B (AI-நேட்டிவ் மென்பொருள் பொறியியல்).";
---

<BaseLayout title={enrollTitle} description={enrollDesc} locale="ta">
  <section class="max-w-5xl mx-auto px-6 pt-16">
    <p class="brand-tagline text-brand-orange">பாடத்திட்ட வரைபடம்</p>
    <h1 class="mt-3 text-4xl md:text-5xl font-semibold">ஒரு பாடத்திட்டத்தில் பதிவு செய்யுங்கள்</h1>

    <p class="mt-6 max-w-3xl text-lg text-brand-off/80">
      K2Labs கடையம், தென்காசியில் மாணவர்கள், சிறு வணிக உரிமையாளர்கள் மற்றும்
      பணிபுரியும் வல்லுநர்களுக்காக நடைமுறை AI பயிற்சியை நடத்துகிறது. இரண்டு
      டிராக்கள், ஒரு இலக்கு: பயன்படுத்தக்கூடிய AI திறன்.
    </p>

    <div class="mt-8 overflow-x-auto border border-brand-navy/60 rounded-lg">
      <table class="w-full min-w-[680px] text-left text-sm">
        <thead class="bg-brand-navy/40 text-brand-off">
          <tr>
            <th class="p-4">ட்ராக்</th>
            <th class="p-4">யாருக்கு</th>
            <th class="p-4">காலம்</th>
            <th class="p-4">முக்கிய விளைவு</th>
          </tr>
        </thead>
        <tbody class="text-brand-off/85">
          <tr class="border-t border-brand-navy/40">
            <td class="p-4 font-semibold text-brand-orange">ட்ராக் A — AI வணிகக் கருவித்தொகுப்பு</td>
            <td class="p-4">மாணவர்கள், சிறு வணிக உரிமையாளர்கள், பணிபுரியும் வல்லுநர்கள்</td>
            <td class="p-4">2 வாரங்கள் · 10 அமர்வுகள் × 90 நிமிடங்கள்</td>
            <td class="p-4">குறியீடு இல்லாமல் அன்றாட வணிகப் பணிகளில் AI பயன்பாடு</td>
          </tr>
          <tr class="border-t border-brand-navy/40">
            <td class="p-4 font-semibold text-brand-orange">ட்ராக் B — AI-நேட்டிவ் மென்பொருள் பொறியியல்</td>
            <td class="p-4">CS/IT பட்டதாரிகள்</td>
            <td class="p-4">4 வாரங்கள் · 90 நிமிட அமர்வுகள்</td>
            <td class="p-4">விவரக்குறிப்பு சார்ந்த, ஏஜென்டிக் மென்பொருள் வழங்கல்</td>
          </tr>
        </tbody>
      </table>
    </div>

    <div class="grid md:grid-cols-2 gap-6 mt-8">
      <article class="border border-brand-navy/60 rounded-lg p-6">
        <h2 class="text-2xl font-semibold text-brand-orange">ட்ராக் A — AI வணிகக் கருவித்தொகுப்பு</h2>
        <p class="mt-3 text-brand-off/80">
          அன்றாட வணிகப் பணிகளுக்கான ஆரம்பநிலைக்கு ஏற்ற AI. இது இரண்டு வாரங்கள்,
          பத்து அமர்வுகள் — ஒவ்வொன்றும் 90 நிமிடங்கள்.
        </p>

        <h3 class="mt-5 text-lg font-semibold">அமர்வு வரைபடம்</h3>
        <p class="mt-2 text-sm text-brand-grey">ஒவ்வொரு 90 நிமிட அமர்வும்: 10 நிமிட செக்-இன், 25 நிமிட கருத்து, 40 நிமிட வழிகாட்டப்பட்ட பயிற்சி, 15 நிமிட வெளியீட்டு மதிப்பீடு.</p>
        <ol class="mt-3 list-decimal list-inside space-y-3 text-sm text-brand-off/85">
          <li><strong>அமர்வு 1 — AI கல்வியறிவு மற்றும் பாதுகாப்பான பயன்பாடு.</strong> AI என்ன செய்ய முடியும், என்ன செய்ய முடியாது; தவறான/மாய தகவல், சார்பு, தனியுரிமை, பதிப்புரிமை; மனித சரிபார்ப்பு. பயிற்சி: தயாரிப்பு விளக்கத்தை எழுதி அதன் கூற்றுகளை சரிபார்க்கவும். வெளியீடு: ஒரு பக்க பாதுகாப்பான பயன்பாட்டு சரிபார்ப்புப் பட்டியல்.</li>
          <li><strong>அமர்வு 2 — வணிகத்திற்கான ப்ராம்ப்ட்.</strong> பங்கு, சூழல், பணி, கட்டுப்பாடுகள், வடிவம், எடுத்துக்காட்டுகள்; மீண்டும் திருத்தம். பயிற்சி: ஒரு தயாரிப்பு விளக்கத்தின் மூன்று பதிப்புகளை எழுதி ஒப்பிடவும். வெளியீடு: மீண்டும் பயன்படுத்தக்கூடிய ப்ராம்ப்ட் டெம்ப்ளேட்.</li>
          <li><strong>அமர்வு 3 — WhatsApp AI.</strong> வாடிக்கையாளர் பதில்கள், அடிக்கடி கேட்கப்படும் கேள்விகள், வாடிக்கையாளர் விவரங்களை சேகரித்தல், பட்டியல் செய்திகள், பின்தொடர்தல்; அனுப்பும் முன் மதிப்பாய்வு; ஒப்புதல் மற்றும் உயர்த்துதல். பயிற்சி: ஐந்து பதில் டெம்ப்ளேட்கள். வெளியீடு: WhatsApp பதில் தொகுப்பு.</li>
          <li><strong>அமர்வு 4 — கேன்வா மற்றும் தயாரிப்பு விளக்கங்கள்.</strong> காட்சி அமைப்பு, பிராண்ட் நிலைத்தன்மை, தயாரிப்பு நகல், படத் தூண்டுதல்கள், பதிப்புரிமை. பயிற்சி: தயாரிப்பு அட்டை அல்லது சமூக இடுகை. வெளியீடு: கேன்வா டெம்ப்ளேட் மற்றும் நகல் எடுத்துக்காட்டுகள்.</li>
          <li><strong>அமர்வு 5 — செலவு கண்காணிப்பு மற்றும் ஆவண டெம்ப்ளேட்டுகள்.</strong> விரிதாள் வகைகள், ரசீதுகள், AI-உதவி பிரித்தெடுத்தல், சரிபார்ப்பு, தனியுரிமை. பயிற்சி: செலவு கண்காணிப்பு மற்றும் விலைப்பட்டியல்/மேற்கோள் டெம்ப்ளேட். வெளியீடு: கண்காணிப்பு மற்றும் ஆவண டெம்ப்ளேட்டுகள்.</li>
          <li><strong>அமர்வு 6 — உண்மையான வணிகப் பணியைத் தேர்வு.</strong> பணிப்பாய்வு மேப்பிங்: உள்ளீடு, வெளியீடு, வெற்றி அளவீடு, ஆபத்து. பயிற்சி: ஒரு பணி; முன்/பின். வெளியீடு: பணி சுருக்கம்.</li>
          <li><strong>அமர்வு 7 — மீண்டும் பயன்படுத்தக்கூடிய கருவித்தொகுப்பு.</strong> ப்ராம்ப்ட்கள், டெம்ப்ளேட்டுகள், SOP, எளிய ஆட்டோமேஷன்; கருவி அடுக்கு. பயிற்சி: கருவித்தொகுப்பை ஒருங்கிணைக்கவும். வெளியீடு: கருவித்தொகுப்பு v1.</li>
          <li><strong>அமர்வு 8 — உண்மையான உதாரணத்துடன் சோதனை.</strong> கருவித்தொகுப்பை உண்மையான வாடிக்கையாளர்/தயாரிப்பு/செலவில் இயக்கவும்; நேரம், பிழைகள்; கருத்து. வெளியீடு: சோதனைப் பதிவு.</li>
          <li><strong>அமர்வு 9 — சுத்திகரிப்பு மற்றும் ஆவணப்படுத்தல்.</strong> ப்ராம்ப்ட் மேம்பாடு, பாதுகாப்பு விதிகள், பதிப்பு, ஒரு பக்க SOP. வெளியீடு: ஆவணப்படுத்தப்பட்ட கருவித்தொகுப்பு.</li>
          <li><strong>அமர்வு 10 — டெமோ நாள்.</strong> முன்/பின், பாதுகாப்பு, அடுத்த படிகள்; சக மதிப்பீடு. வெளியீடு: டெமோ மற்றும் செயல் திட்டம்.</li>
        </ol>

        <h3 class="mt-5 text-lg font-semibold">நீங்கள் பெறுவீர்கள்</h3>
        <ul class="mt-3 space-y-2 text-sm text-brand-off/85">
          <li>மீண்டும் பயன்படுத்தக்கூடிய ப்ராம்ட் மற்றும் பணிப்பாய்வு பேக்.</li>
          <li>கேன்வா டெம்ப்ளேட்கள் மற்றும் தயாரிப்பு நகல் எடுத்துக்காட்டுகள்.</li>
          <li>செலவு கண்காணிப்பு மற்றும் ஆவண டெம்ப்ளேட்டுகள்.</li>
          <li>டெமோவுக்கு தயாரான வணிகக் கருவித்தொகுப்பு.</li>
        </ul>

        <p class="mt-5 text-sm text-brand-grey">முன்நிபந்தனைகள்: இல்லை. குறியீட்டு முறை அல்லது கணிதம் தேவையில்லை.</p>
      </article>

      <article class="border border-brand-navy/60 rounded-lg p-6">
        <h2 class="text-2xl font-semibold text-brand-orange">ட்ராக் B — AI-நேட்டிவ் மென்பொருள் பொறியியல்</h2>
        <p class="mt-3 text-brand-off/80">
          CS/IT பட்டதாரிகளுக்கான விவரக்குறிப்பு சார்ந்த, ஏஜென்டிக் மென்பொருள்
          வழங்கல். இது நான்கு வாரங்கள், 90 நிமிட அமர்வுகள்.
        </p>

        <h3 class="mt-5 text-lg font-semibold">வார வரைபடம்</h3>
        <ol class="mt-3 list-decimal list-inside space-y-2 text-sm text-brand-off/85">
          <li><strong>வாரம் 1:</strong> விவரக்குறிப்பு சார்ந்த பொறியியல் — விவரக்குறிப்பை எழுதுதல், ஏற்றுக்கொள்ளலை வரையறுத்தல், பணிப்பாய்வு மாதிரி.</li>
          <li><strong>வாரம் 2:</strong> பை/ஓப்பன்கோடு கொண்ட ஏஜென்டிக் லூப்கள் — கருவிகள், ப்ராம்ட்கள், சரிபார்ப்பு, மறு செய்கை.</li>
          <li><strong>வாரம் 3:</strong> உள்ளூர் வரிசைப்படுத்தல் — உள்ளூர் உள்கட்டமைப்பில் கணினியை இயக்கி சோதிக்கவும்; தரவை வீட்டிற்கு அருகில் வைத்திருக்கவும்.</li>
          <li><strong>வாரம் 4:</strong> கேப்ஸ்டோன் — பஞ்சாயத்து ஸ்மார்ட்-சர்வீசஸ் ஹப்; ஒருங்கிணைக்கவும், சரிபார்க்கவும், முன்மாதிரியை வழங்கவும்.</li>
        </ol>

        <h3 class="mt-5 text-lg font-semibold">நீங்கள் பெறுவீர்கள்</h3>
        <ul class="mt-3 space-y-2 text-sm text-brand-off/85">
          <li>பொறியியல் விவரக்குறிப்பு.</li>
          <li>ஏஜென்டிக் பணிப்பாய்வு.</li>
          <li>உள்ளூர் வரிசைப்படுத்தல்.</li>
          <li>சரிபார்க்கப்பட்ட கேப்ஸ்டோன் முன்மாதிரி.</li>
        </ul>

        <p class="mt-5 text-sm text-brand-grey">முன்நிபந்தனைகள்: CS/IT பட்டம்; குறியீடு எழுதும் திறன் மற்றும் உள்ளூர் அமைப்பு அனுபவம்.</p>
      </article>
    </div>

    <section class="mt-14">
      <h2 class="text-2xl font-semibold">பாடத்திட்டம் எவ்வாறு இயங்குகிறது</h2>
      <ul class="mt-4 space-y-2 text-brand-off/80">
        <li>தென்காசி, கடையத்தில் உள்ள K2Labs பயிற்சி மையத்தில் நேரடியாக.</li>
        <li>கூட்டு அடிப்படையிலான, 90 நிமிட அமர்வுகள்.</li>
        <li>மாணவர்கள், சிறு வணிக உரிமையாளர்கள், பணிபுரியும் வல்லுநர்கள் விண்ணப்பிக்கலாம்.</li>
        <li>பெயர், தொடர்பு, டிராக், நகரம் உள்ள Google படிவத்தை நிரப்பவும்.</li>
        <li>48 மணி நேரத்திற்குள் இருக்கை கிடைப்பதை உறுதி செய்கிறோம்.</li>
        <li>பொருட்கள் முதல் நாளில் ஒருங்கிணைக்கப்படுகின்றன.</li>
        <li>நாள்-1 டெமோ வகுப்பு — சேர்வதற்கு முன் மையத்தைப் பார்க்க.</li>
      </ul>
    </section>
  </section>

  <!-- Enrollment form -->
  <section class="max-w-5xl mx-auto px-6 mb-24">
    <h2 class="text-2xl font-semibold mb-6">பதிவு படிவம்</h2>

    {GOOGLE_FORM_READY ? (
      <div class="border border-brand-navy/60 rounded-lg overflow-hidden">
        <iframe
          src={GOOGLE_FORM_EMBED_SRC}
          title="K2Labs Enrollment Form"
          class="w-full min-h-[820px]"
        ></iframe>
      </div>
    ) : (
      <div class="border border-dashed border-brand-navy rounded-lg p-8 text-center">
