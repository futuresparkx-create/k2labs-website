---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Experience from "../../components/Experience.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BaseLayout
  title="K2Labs - செயலுக்கான அறிவு"
  description="நிஜ உலகப் பிரச்சனைகளுக்கு அறிவை அணுகக்கூடிய, நெறிமுறைத் தீர்வுகளாக மாற்றும் சமூகம் சார்ந்த ஆராய்ச்சி ஆய்வகம்."
  locale="ta"
>
  <!-- Narrated cover -->
  <section class="max-w-6xl mx-auto px-6 pt-16">
    <p class="brand-tagline text-brand-orange mb-4">K2Labs · Innovations</p>
    <h1 class="text-3xl md:text-4xl font-semibold leading-tight">
      அறிவு, ஆய்வகங்களில் சோதிக்கப்பட்டது,<br />
      செயலாக மாற்றப்பட்டது.
    </h1>
  </section>

  <section class="mt-8">
    <Experience slug="home" locale="ta" />
  </section>

  <!-- Readable summary -->
  <section class="max-w-6xl mx-auto px-6 mt-20">
    <p class="max-w-3xl text-brand-off/80">
      K2Labs என்பது ஆராய்ச்சி-முதல் சமூக ஆய்வகமாகும், அங்கு கற்றல், கட்டமைத்தல் மற்றும் பங்களிப்பு ஆகியவை கைகோர்த்து, ஒத்துழைக்கும் மற்றும் உண்மையான வேடிக்கையாக வடிவமைக்கப்பட்டுள்ளன. உண்மையான சிக்கல்களைத் தீர்ப்பதன் மூலம் சிறந்த கற்றல் நடக்கும் என்று நாங்கள் நம்புகிறோம் — மாணவர்கள் இங்கு அமைப்புகளை மட்டும் படிப்பதில்லை, அவற்றை உருவாக்க உதவுகிறார்கள்.
    </p>
  </section>

  <!-- What We Do -->
  <section class="max-w-6xl mx-auto px-6 mt-20">
    <h2 class="text-2xl font-semibold">நாம் என்ன செய்கிறோம்</h2>

    <div class="grid md:grid-cols-2 gap-8 mt-8 text-brand-off/80">
      <p>சமூகங்கள் எதிர்கொள்ளும் உண்மையான பிரச்சனைகளை—குறிப்பாக அடுக்கு-3 சூழல்களில்—கண்டறிந்து அவற்றை மையப்படுத்தப்பட்ட ஆராய்ச்சி கேள்விகளாக மாற்றுகிறோம்.</p>
      <p>மாணவர்கள், தன்னார்வத் தொண்டர்கள் மற்றும் நிபுணர்களுக்கு இடையிலான ஒத்துழைப்பின் மூலம், AI மற்றும் நவீன அமைப்புகளைப் பயன்படுத்தி நெறிமுறைகள், அணுகல்தன்மை மற்றும் நிலைத்தன்மை ஆகியவற்றை மையமாகக் கொண்டு தீர்வுகளை முன்மாதிரி செய்கிறோம்.</p>
    </div>
  </section>

  <!-- Research Focus -->
  <section class="max-w-6xl mx-auto px-6 mt-20">
    <h2 class="text-2xl font-semibold">செயலில் உள்ள ஆராய்ச்சி ஆய்வகங்கள்</h2>

    <div class="grid md:grid-cols-2 gap-10 mt-10">
      <div class="border border-brand-navy/60 rounded-lg p-6">
        <h3 class="text-xl font-semibold">AI சிஸ்டம்ஸ் லேப்</h3>
        <p class="mt-4 text-brand-off/80">நிஜ உலகக் கட்டுப்பாடுகளின் கீழ் செயல்படும் நடைமுறை AI அமைப்புகளை ஆராய்தல் மற்றும் அறிவார்ந்த கருவிகளுக்கான அணுகல் குறைவாக இருக்கும் சமூகங்களை ஆதரிக்கிறது.</p>
        <p class="mt-4 text-sm text-brand-grey">தற்போதைய நிலை: முன்மாதிரி</p>
      </div>

      <div class="border border-brand-navy/60 rounded-lg p-6">
        <h3 class="text-xl font-semibold">மருத்துவ நுண்ணறிவு ஆய்வகம்</h3>
        <p class="mt-4 text-brand-off/80">நோயாளிகள் மற்றும் மருத்துவர்களை ஆதரிப்பதற்காக உதவி நுண்ணறிவை உருவாக்குதல், பயன்பாட்டினை, பாதுகாப்பு மற்றும் மனிதர்கள்-இன்-தி-லூப் முடிவெடுப்பதில் கவனம் செலுத்துதல்.</p>
        <p class="mt-4 text-sm text-brand-grey">தற்போதைய நிலை: முன்மாதிரி</p>
      </div>
    </div>
  </section>

  <!-- Philosophy -->
  <section class="max-w-6xl mx-auto px-6 mt-20">
    <h2 class="text-2xl font-semibold">எங்கள் தத்துவம்</h2>

    <p class="mt-6 max-w-3xl text-brand-off/80">
      மனித வாழ்க்கையை மேம்படுத்தும் போதுதான் அறிவுக்கு மதிப்பு கிடைக்கும். K2Labs இல், அர்த்தமுள்ள கண்டுபிடிப்புகள் சமூகங்களில் தொடங்கி, பொறுப்பான ஆராய்ச்சியின் மூலம் வளரும் மற்றும் நெறிமுறை, மலிவு மற்றும் அணுகக்கூடிய செயல்களில் முதிர்ச்சியடையும் என்று நாங்கள் நம்புகிறோம்.
    </p>
  </section>

  <!-- Call to Collaborate -->
  <section class="max-w-6xl mx-auto px-6 mt-20 mb-24">
    <div class="border border-brand-navy/60 rounded-lg p-8">
      <h2 class="text-2xl font-semibold">எங்களுடன் ஒத்துழைக்கவும்</h2>
      <p class="mt-4 max-w-2xl text-brand-off/80">
        முக்கியமான தீர்வுகளை உருவாக்குவதன் மூலம் கற்றுக்கொள்ளவும் பங்களிக்கவும் விரும்பும் மாணவர்கள், தன்னார்வலர்கள், நிபுணர்கள் மற்றும் சமூகங்களை நாங்கள் வரவேற்கிறோம்.
      </p>

      <a
        href={`${base}/ta/contact/`}
        class="inline-block mt-6 px-6 py-3 rounded-md bg-brand-orange text-brand-dark font-semibold hover:bg-brand-off"
      >
        தொடர்பு கொள்ளவும்
      </a>
    </div>
  </section>
</BaseLayout>
