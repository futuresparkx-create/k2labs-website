---
import BaseLayout from "../layouts/BaseLayout.astro";
import { GOOGLE_FORM_URL, GOOGLE_FORM_EMBED_SRC, GOOGLE_FORM_READY } from "../config";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const enrollTitle = "Enroll in a Course — K2Labs";
const enrollDesc = "Join the K2Labs AI training centre in Kadayam, Tenkasi. Track A (AI Business Toolkit) for beginners and Track B (AI-Native Software Engineering) for CS/IT graduates.";
---

<BaseLayout title={enrollTitle} description={enrollDesc} locale="en">
  <section class="max-w-5xl mx-auto px-6 pt-16">
    <p class="brand-tagline text-brand-orange">COURSE MAP</p>
    <h1 class="mt-3 text-4xl md:text-5xl font-semibold">Enroll in a Course</h1>

    <p class="mt-6 max-w-3xl text-lg text-brand-off/80">
      K2Labs runs practical AI training in Kadayam, Tenkasi — for students,
      small business owners, and working professionals. Two tracks, one goal:
      usable AI capability.
    </p>

    <div class="mt-8 overflow-x-auto border border-brand-navy/60 rounded-lg">
      <table class="w-full min-w-[680px] text-left text-sm">
        <thead class="bg-brand-navy/40 text-brand-off">
          <tr>
            <th class="p-4">Track</th>
            <th class="p-4">Who it is for</th>
            <th class="p-4">Duration</th>
            <th class="p-4">Core outcome</th>
          </tr>
        </thead>
        <tbody class="text-brand-off/85">
          <tr class="border-t border-brand-navy/40">
            <td class="p-4 font-semibold text-brand-orange">Track A — AI Business Toolkit</td>
            <td class="p-4">Students, small business owners, working professionals</td>
            <td class="p-4">2 weeks · 10 sessions × 90 min</td>
            <td class="p-4">Use AI in everyday business work without coding</td>
          </tr>
          <tr class="border-t border-brand-navy/40">
            <td class="p-4 font-semibold text-brand-orange">Track B — AI-Native Software Engineering</td>
            <td class="p-4">CS/IT graduates</td>
            <td class="p-4">4 weeks · 90-min sessions</td>
            <td class="p-4">Specification-driven, agentic software delivery</td>
          </tr>
        </tbody>
      </table>
    </div>

    <div class="grid md:grid-cols-2 gap-6 mt-8">
      <article class="border border-brand-navy/60 rounded-lg p-6">
        <h2 class="text-2xl font-semibold text-brand-orange">Track A — AI Business Toolkit</h2>
        <p class="mt-3 text-brand-off/80">
          Beginner-friendly AI for everyday business work. It runs for two weeks
          and ten 90-minute sessions.
        </p>

        <h3 class="mt-5 text-lg font-semibold">Session-by-session plan</h3>
        <p class="mt-2 text-sm text-brand-grey">Each 90-minute session: 10 min check-in, 25 min concept, 40 min guided practice, 15 min artifact review.</p>
        <ol class="mt-3 list-decimal list-inside space-y-3 text-sm text-brand-off/85">
          <li><strong>Session 1 — AI literacy and safe use.</strong> Teach what generative AI can and cannot do; hallucination, bias, privacy, copyright; human verification. Practice: draft a product description and fact-check its claims. Artifact: a one-page safe-use checklist.</li>
          <li><strong>Session 2 — Prompting for business.</strong> Teach role, context, task, constraints, format, and examples; iterate. Practice: write three versions of a product description and compare them. Artifact: a reusable prompt template.</li>
          <li><strong>Session 3 — WhatsApp AI.</strong> Teach customer replies, FAQs, lead capture, catalog messages, and follow-up; review before sending; consent and escalation. Practice: build five reply templates. Artifact: a WhatsApp response pack.</li>
          <li><strong>Session 4 — Canva and product descriptions.</strong> Teach visual layout, brand consistency, product copy, image prompts, and copyright. Practice: create a product card or social post. Artifact: a Canva template and copy examples.</li>
          <li><strong>Session 5 — Expense tracking and document templates.</strong> Teach spreadsheet categories, receipts, AI-assisted extraction, verification, and privacy. Practice: build an expense tracker and an invoice/quote template. Artifact: tracker and document templates.</li>
          <li><strong>Session 6 — Choose a real business task.</strong> Teach workflow mapping: input, output, success metric, and risk. Practice: pick one real task and define before/after. Artifact: a task brief.</li>
          <li><strong>Session 7 — Build a reusable toolkit.</strong> Teach prompts, templates, SOP, and simple automation; choose the tool stack. Practice: assemble the toolkit. Artifact: toolkit v1.</li>
          <li><strong>Session 8 — Test with a real example.</strong> Teach testing: run the toolkit on an actual customer, product, or expense; measure time and errors; collect feedback. Artifact: a test log.</li>
          <li><strong>Session 9 — Refine and document.</strong> Teach prompt improvement, guardrails, versioning, and a one-page SOP. Artifact: a documented toolkit.</li>
          <li><strong>Session 10 — Demo day.</strong> Teach presentation: before/after, safety, and next steps; peer feedback. Artifact: a demo and action plan.</li>
        </ol>

        <h3 class="mt-5 text-lg font-semibold">You leave with</h3>
        <ul class="mt-3 space-y-2 text-sm text-brand-off/85">
          <li>A reusable prompt and workflow pack.</li>
          <li>Canva templates and product-copy examples.</li>
          <li>An expense tracker and document templates.</li>
          <li>A demo-ready business toolkit.</li>
        </ul>

        <p class="mt-5 text-sm text-brand-grey">Prerequisites: none. No coding or math is required.</p>
      </article>

      <article class="border border-brand-navy/60 rounded-lg p-6">
        <h2 class="text-2xl font-semibold text-brand-orange">Track B — AI-Native Software Engineering</h2>
        <p class="mt-3 text-brand-off/80">
          Specification-driven, agentic software delivery for CS/IT graduates.
          It runs for four weeks with 90-minute sessions.
        </p>

        <h3 class="mt-5 text-lg font-semibold">Week map</h3>
        <ol class="mt-3 list-decimal list-inside space-y-2 text-sm text-brand-off/85">
          <li><strong>Week 1:</strong> specification-driven engineering — write the spec, define acceptance, and model the workflow.</li>
          <li><strong>Week 2:</strong> agentic loops with pi/opencode — tools, prompts, verification, and iteration.</li>
          <li><strong>Week 3:</strong> local deployment — run and test the system on local infrastructure and keep data close to home.</li>
          <li><strong>Week 4:</strong> capstone — the Panchayat Smart-Services Hub; integrate, validate, and present the prototype.</li>
        </ol>

        <h3 class="mt-5 text-lg font-semibold">You leave with</h3>
        <ul class="mt-3 space-y-2 text-sm text-brand-off/85">
          <li>An engineered specification.</li>
          <li>An agentic workflow.</li>
          <li>A local deployment.</li>
          <li>A validated capstone prototype.</li>
        </ul>

        <p class="mt-5 text-sm text-brand-grey">Prerequisites: a CS/IT degree and comfort with code and local setup.</p>
      </article>
    </div>

    <section class="mt-14">
      <h2 class="text-2xl font-semibold">How the course runs</h2>
      <ul class="mt-4 space-y-2 text-brand-off/80">
        <li>In-person at the K2Labs training centre in Kadayam, Tenkasi.</li>
        <li>Cohort-based, hands-on sessions of 90 minutes.</li>
        <li>Open to students, small business owners, and working professionals.</li>
        <li>Fill the Google Form with name, contact, track, and city.</li>
        <li>We confirm seat availability within 48 hours.</li>
        <li>Materials are coordinated on the first day.</li>
        <li>A Day-1 demo class lets you see the centre before you commit.</li>
      </ul>
    </section>
  </section>

  <!-- Enrollment form -->
  <section class="max-w-5xl mx-auto px-6 mb-24">
    <h2 class="text-2xl font-semibold mb-6">Enrollment Form</h2>

    {GOOGLE_FORM_READY ? (
      <div class="border border-brand-navy/60 rounded-lg overflow-hidden">
        <iframe
          src={GOOGLE_FORM_EMBED_SRC}
          title="K2Labs Enrollment Form"
          class="w-full min-h-[820px]"
        ></iframe>
      </div>
    ) : (
      <div class="border border-dashed border-brand-navy rounded-lg p-8 text-center">
        <p class="text-xl font-medium text-brand-off">The enrollment form is being set up.</p>
        <p class="mt-3 text-brand-off/80">
          For now, reach us directly on WhatsApp or by email — and we can confirm
          your seat.
        </p>
        <p class="mt-4">
          <a href={`${base}/contact`} class="text-lg font-medium text-brand-orange underline hover:text-brand-off">Contact us →</a>
        </p>
      </div>
    )}
  </section>
</BaseLayout>
