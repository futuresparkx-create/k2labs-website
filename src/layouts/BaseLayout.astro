---
import "../styles/global.css";
const { title = "K2Labs", description = "Knowledge transformed into action to improve human life." } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta name="theme-color" content="#0f172a" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>

  <body class="min-h-screen">
    <!-- Header -->
    <header class="border-b border-slate-800">
      <div class="max-w-6xl mx-auto px-6 py-4 flex justify-between items-center">
        <a href="/" class="flex items-center gap-3">
          <img src="/logo.svg" alt="K2Labs" class="h-10" />
          <span class="text-amber text-xl md:text-2xl font-semibold">K2Labs</span>
        </a>

        <nav class="space-x-6 text-lg md:text-xl text-slate-100">
          <a href="/vision" class="hover:text-amber font-medium">Vision</a>
          <a href="/mission" class="hover:text-amber font-medium">Mission</a>
          <a href="/labs" class="hover:text-amber font-medium">Labs</a>
          <a href="/ethics" class="hover:text-amber font-medium">Ethics</a>
          <a href="/contact" class="hover:text-amber font-medium">Contact</a>
        </nav>
      </div>
    </header>

    <!-- Page Content -->
    <main class="min-h-screen">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-slate-800 mt-24">
      <div class="max-w-6xl mx-auto px-6 py-8 text-sm text-slate-300">
        <p>
          © {new Date().getFullYear()} K2Labs. Knowledge multiplied through responsible action.
        </p>
        <p class="mt-2">
          Built for communities. Deployed responsibly.
        </p>
      </div>
    </footer>
  </body>
</html>
