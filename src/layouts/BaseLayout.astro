---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  locale?: "en" | "ta";
}

const {
  title = "K2Labs",
  description = "Knowledge transformed into action to improve human life.",
  locale = "en",
} = Astro.props;

const isTa = locale === "ta";

// --- Base path (GitHub Pages project site) ────────────────────────────────
// Astro serves this site under /k2labs-website/ — every internal path must
// carry that prefix, including assets.
const base = import.meta.env.BASE_URL; // "/k2labs-website"
const baseTrim = base.replace(/\/$/, ""); // "/k2labs-website"
const stripBase = (p) => (p.startsWith(baseTrim) ? p.slice(baseTrim.length) : p);

// English lives at /, Tamil lives at /ta/
const href = (path) => (isTa ? (path === "/" ? `${baseTrim}/ta` : `${baseTrim}/ta${path}`) : (path === "/" ? baseTrim + "/" : `${baseTrim}${path}`)) + (path !== "/" && !path.endsWith("/") ? "/" : "");

const currentBase = stripBase(Astro.url.pathname) || "/";
const currentPage = currentBase.replace(/^\/ta(\/|$)/, "/") || "/";
const currentPageStripped = currentPage.replace(/\/$/, "") || "";
const otherLocaleHref = isTa
  ? `${baseTrim}${currentPageStripped ? `${currentPageStripped}/` : "/"}`
  : `${baseTrim}/ta${currentPageStripped ? `${currentPageStripped}/` : "/"}`;

// --- Localized strings (language-switcher + nav + footer) ───────────────
const NAV = [
  { path: "/vision", en: "Vision", ta: "பார்வை" },
  { path: "/mission", en: "Mission", ta: "பணி" },
  { path: "/labs", en: "Labs", ta: "ஆய்வகங்கள்" },
  { path: "/ethics", en: "Ethics", ta: "நெறிமுறைகள்" },
  { path: "/contact", en: "Contact", ta: "தொடர்பு" },
];
const ENROLL_LABEL = isTa ? "பதிவு" : "Enroll";
const TOGGLE_LABEL = isTa ? "ஆங்கிலம்" : "தமிழ்";
const FOOTER_LINES = isTa
  ? ["© {year} K2Labs. பொறுப்பான செயலின் மூலம் அறிவு பெருகும்.", "சமூகங்களுக்காக உருவாக்கப்பட்டது. பொறுப்புடன் நிறுவப்பட்டது."]
  : ["© {year} K2Labs. Knowledge multiplied through responsible action.", "Built for communities. Deployed responsibly."];

const year = new Date().getFullYear();
const footer = FOOTER_LINES.map((l) => l.replace("{year}", String(year)));

// --- SEO: canonical + hreflang (only when `site` is configured) ─────────
const site = Astro.site;
const pagePath = currentPageStripped || "";
const toAbsolute = (path) => site ? new URL(`${baseTrim}${path}`, site).toString() : undefined;
const canonical = toAbsolute(isTa ? (pagePath === "" ? "/ta/" : `/ta${pagePath}/`) : (pagePath === "" ? "/" : `${pagePath}/`));
const altLinks = site
  ? (["en", "ta"] as const).map((l) => ({
      hreflang: l,
      href: toAbsolute(l === "ta" ? (pagePath === "" ? "/ta/" : `/ta${pagePath}/`) : (pagePath === "" ? "/" : `${pagePath}/`)),
    }))
  : [];
const xDefault = site ? toAbsolute(pagePath === "" ? "/" : `${pagePath}/`) : undefined;
---

<!DOCTYPE html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#07101f" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&display=swap" rel="stylesheet" />

    {canonical && <link rel="canonical" href={canonical} />}
    {altLinks.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    {xDefault && <link rel="alternate" hreflang="x-default" href={xDefault} />}

    <link rel="icon" type="image/svg+xml" href={`${baseTrim}/favicon.svg`} />
  </head>

  <body class="min-h-screen">
    <!-- Header -->
    <header class="site-header">
      <div class="max-w-6xl mx-auto px-6 py-4 flex justify-between items-center gap-4">
        <a href={href("/")} class="flex items-center gap-3 shrink-0">
          <img src={`${baseTrim}/brand-mark.svg`} alt="K2Labs mark" class="brand-mark h-11 w-11" />
          <span class="flex flex-col leading-tight">
            <span class="brand-wordmark text-xl md:text-2xl">
              <span class="text-brand-off">K</span><span class="text-brand-orange">2</span><span class="text-brand-grey">Labs</span>
            </span>
            <span class="brand-tagline mt-0.5 text-brand-grey">Innovations</span>
          </span>
        </a>

        <nav class="site-nav nav-scroll flex items-center gap-4 md:gap-5 text-base md:text-lg">
          {NAV.map((item) => (
            <a href={href(item.path)} class="nav-link whitespace-nowrap">
              {isTa ? item.ta : item.en}
            </a>
          ))}
          <a
            href={href("/enroll")}
            class="whitespace-nowrap rounded-md bg-brand-orange px-3.5 py-2 text-brand-dark font-extrabold hover:bg-brand-off"
          >
            {ENROLL_LABEL}
          </a>
          <a
            href={otherLocaleHref}
            lang={isTa ? "en" : "ta"}
            class="whitespace-nowrap rounded-full border border-brand-sky/60 px-3 py-2 text-sm text-brand-grey hover:text-brand-orange hover:border-brand-orange"
            title={isTa ? "Switch to English" : "தமிழுக்கு மாறு"}
          >
            {TOGGLE_LABEL}
          </a>
        </nav>
      </div>
    </header>

    <!-- Page Content -->
    <main class="min-h-screen">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t-4 border-brand-orange mt-24 bg-brand-dark/80">
      <div class="max-w-6xl mx-auto px-6 py-8 text-sm text-brand-grey">
        {footer.map((line) => (
          <p class="mt-2 first:mt-0">{line}</p>
        ))}
        <p class="brand-tagline mt-5 text-brand-orange">K2Labs · Innovations</p>
      </div>
    </footer>
  </body>
</html>
